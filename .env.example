# =============================================================================
# polybot secrets -- copy to .env and fill in.  NEVER commit .env to git.
# On the VPS:  chmod 600 .env  &&  chown polymarketbot:polymarketbot .env
# =============================================================================

# --- Notifications (optional in analysis/paper) -----------------------------
# Generic webhook (Slack/Discord/n8n/Make/your own relay -> WhatsApp, etc.)
WEBHOOK_URL=
# Sent as Authorization: Bearer <token> if your endpoint requires auth.
WEBHOOK_TOKEN=

# --- LIVE execution secrets (LEAVE BLANK FOR V1 -- live is disabled) --------
# Polymarket / Polygon wallet private key. Only needed when live_enabled=true.
# DO NOT fill this in until you have read deploy/DEPLOY.md and accept the risk.
POLY_PRIVATE_KEY=
# CLOB API credentials (derived from the wallet via the CLOB auth flow).
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=
# Optional: proxy/funder address if you trade via a Polymarket proxy wallet.
POLY_FUNDER_ADDRESS=
