# =============================================================================
# polybot local watcher config. Copy to /opt/polybot/watcher.env and edit.
#   sudo -u polymarketbot cp deploy/watcher.env.example /opt/polybot/watcher.env
#   sudo chmod 600 /opt/polybot/watcher.env   # if your send cmd references a token
# This file is git-ignored. Do NOT put it in the repo.
# =============================================================================

# --- Delivery command -------------------------------------------------------
# The watcher pipes each alert message to this command on STDIN. It is the ONLY
# integration point for WhatsApp/OpenClaw. Leave blank to log to journald only.
#
# RECOMMENDED (OpenClaw via the locked sudo bridge -- no secret reaches this user):
#   Install once:  sudo bash deploy/install_notify_bridge.sh   (see deploy/WATCHER.md)
#   Then set:
#   WATCHER_SEND_CMD=sudo -n /usr/local/bin/polybot-notify
#
# Other options (uncomment ONE and adapt). The token/secret lives in the
# referenced tool/env, NEVER in the repo.
#
#   # a) Direct OpenClaw CLI (only works if THIS user has the OpenClaw channel):
#   WATCHER_SEND_CMD=openclaw message send --channel whatsapp -t +52XXXXXXXXXX -m "$(cat)"
#
#   # b) Local HTTP gateway (reads body from stdin via curl --data-binary @-):
#   WATCHER_SEND_CMD=curl -fsS -X POST "$WHATSAPP_GATEWAY_URL" --data-binary @-
#
#   # c) WhatsApp Cloud API style (token comes from this file's env, not the repo):
#   WATCHER_SEND_CMD=sh -c 'curl -fsS -X POST "https://graph.facebook.com/v20.0/$WA_PHONE_ID/messages" -H "Authorization: Bearer $WA_TOKEN" -H "Content-Type: application/json" -d "{\"messaging_product\":\"whatsapp\",\"to\":\"$WA_TO\",\"type\":\"text\",\"text\":{\"body\":\"$(cat)\"}}"'
#
# If you fill in (c), also set these here (file is chmod 600, git-ignored):
# WA_TOKEN=
# WA_PHONE_ID=
# WA_TO=
# WHATSAPP_GATEWAY_URL=

WATCHER_SEND_CMD=

# --- Behavior ---------------------------------------------------------------
WATCHER_POLL_SECONDS=5
WATCHER_SEND_RETRIES=3
WATCHER_RETRY_BACKOFF=2
WATCHER_ALERT_RISK_BLOCK=0      # 1 = also alert risk blocks (noisy)
WATCHER_FROM_START=0            # 1 = replay the whole outbox once on next start

# Paths default to /opt/polybot/data/* via POLYBOT_ROOT; override if needed.
# WATCHER_OUTBOX=/opt/polybot/data/outbox.jsonl
# WATCHER_STATE=/opt/polybot/data/local_watcher.state.json
# WATCHER_FAILED=/opt/polybot/data/local_watcher.failed.jsonl
